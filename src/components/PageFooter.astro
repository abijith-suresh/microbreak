---
interface Props {
  currentPage?: "home" | "about";
}

const { currentPage } = Astro.props;
---

{/* One compact row on phones (the tagline joins from sm up). The bottom padding clears the
    home indicator and the browser's toolbar on phones with a safe area. */}
<footer
  class="page-frame pb-[max(1rem,env(safe-area-inset-bottom))] sm:pb-[max(2.5rem,env(safe-area-inset-bottom))]"
>
  <div
    class="flex items-baseline justify-between gap-4 border-t border-border pt-3 sm:pt-6"
  >
    <p class="min-w-0 text-sm text-fg-tertiary">
      <a href="/" class="font-display text-base text-fg-secondary italic hover:text-accent sm:text-lg">
        Microbreak
      </a>
      <span class="hidden sm:inline">
        <span class="mx-1.5 opacity-50">·</span>
        A brain gym for agent wait time
      </span>
    </p>
    <nav class="flex shrink-0 gap-4 text-[13px] text-fg-tertiary sm:gap-5 sm:text-sm">
      {
        currentPage !== "about" && (
          <a href="/about" class="hover:text-fg transition-colors">
            About
          </a>
        )
      }
      <a
        href="https://github.com/abijith-suresh/microbreak"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-fg transition-colors">GitHub</a
      >
    </nav>
  </div>
</footer>
