---
interface Props {
  currentPage?: "home" | "about";
}

const { currentPage } = Astro.props;
---

<footer class="page-frame pb-10">
  <div
    class="flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-baseline sm:justify-between"
  >
    <p class="text-sm text-fg-tertiary">
      <a href="/" class="font-display text-lg text-fg-secondary italic hover:text-accent">
        Microbreak
      </a>
      <span class="mx-1.5 opacity-50">·</span>
      A brain gym for agent wait time
    </p>
    <nav class="flex gap-5 text-sm text-fg-tertiary">
      {
        currentPage !== "about" && (
          <a href="/about" class="hover:text-fg transition-colors">
            About
          </a>
        )
      }
      <a
        href="https://github.com/abijith-suresh/microbreak"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-fg transition-colors">GitHub</a
      >
    </nav>
  </div>
</footer>
