---
import { House } from "@lucide/astro";
import PageFooter from "@/components/PageFooter.astro";
import PageHeader from "@/components/PageHeader.astro";
import { buttonVariants } from "@/components/ui/Button";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Page not found · Microbreak" description="Nothing here.">
  <div class="min-h-screen flex flex-col">
    <PageHeader title="404" />

    <main class="page-frame flex-1 pb-24">
      <p class="font-display text-3xl md:text-4xl text-fg tracking-tight italic">Nothing here.</p>
      <div class="mt-8">
        <a href="/" class={buttonVariants({ variant: "primary", size: "lg" })}>
          <House size={16} />
          Back to games
        </a>
      </div>
    </main>

    <PageFooter />
  </div>
</BaseLayout>
