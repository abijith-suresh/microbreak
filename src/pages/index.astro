---
import GameGrid from "@/components/GameGrid";
import PageFooter from "@/components/PageFooter.astro";
import ThemeToggle from "@/components/ThemeToggle";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="flex min-h-dvh flex-col">
    {/* The same bar as the game screens, then straight to the games. */}
    <header class="border-b border-border">
      <div class="page-frame flex h-14 items-center sm:h-15">
        <h1 class="font-display text-[24px] leading-none text-fg italic sm:text-[30px]">
          Microbreak
        </h1>
        <div class="ml-auto">
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main class="page-frame flex-1 pt-4 pb-12 sm:pt-8 sm:pb-16">
      <GameGrid client:load />
    </main>

    <PageFooter currentPage="home" />
  </div>
</BaseLayout>
