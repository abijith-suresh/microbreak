---
import { House } from "@lucide/astro";
import PageFooter from "@/components/PageFooter.astro";
import PageHeader from "@/components/PageHeader.astro";
import { buttonVariants } from "@/components/ui/Button";
import { getOrderedGames } from "@/data/games";
import BaseLayout from "@/layouts/BaseLayout.astro";

const gameNames = new Intl.ListFormat("en").format(
  getOrderedGames()
    .filter((game) => game.status === "available")
    .map((game) => game.name)
);
---

<BaseLayout
  title="About — Microbreak"
  description="Thinking games for agent wait time. Every game saves as you play. No accounts, ads or tracking."
>
  <div class="min-h-screen flex flex-col">
    <PageHeader title="About" />

    <main class="flex-1 px-5 md:px-10 pb-16">
      <article class="max-w-prose">
        <div class="space-y-5 text-base text-fg-secondary leading-relaxed md:text-lg">
          <p>
            An agent run takes a few minutes. That's too short to start something else and long
            enough to lose you to a feed.
          </p>
          <p>
            Microbreak gives you {gameNames} instead. Each one takes real thought and saves as you
            play. Leave when an agent needs you, and come back to it after a reload, a closed tab or
            a day away.
          </p>
          <p>
            No accounts, ads or tracking. No streaks, notifications or leaderboards. Your games stay
            in your browser.
          </p>
        </div>

        <div class="mt-10">
          <a href="/" class={buttonVariants({ variant: "primary" })}>
            <House size={16} />
            Back to games
          </a>
        </div>
      </article>
    </main>

    <PageFooter currentPage="about" />
  </div>
</BaseLayout>
