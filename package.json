{
  "name": "microbreak",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "version": "0.0.16",
  "license": "MIT",
  "homepage": "https://github.com/abijith-suresh/microbreak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abijith-suresh/microbreak.git"
  },
  "bugs": {
    "url": "https://github.com/abijith-suresh/microbreak/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:build": "bun run build && bun run test:e2e",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/solid-js": "^7.1.6",
    "@lucide/astro": "^1.73.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "solid-js": "^1.9.19",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.0"
  }
}
